sts\r\n      pendingRequests.delete(cacheKey);\r\n    }\r\n  })", "is_member_call": false, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L342"}, {"caller_nid": "services_geojsonservice_fetchgeojson", "callee": "set", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L377"}, {"caller_nid": "services_geojsonservice_fetchbathymetrylayer", "callee": "get", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L402"}, {"caller_nid": "services_geojsonservice_fetchbathymetrylayer", "callee": "(async (): Promise<GeoJSONCollection> => {\r\n    const url = buildBathymetryUrl(depth, resolution);\r\n\r\n    try {\r\n      const response = await fetch(url);\r\n\r\n      if (!response.ok) {\r\n        console.warn(\r\n          `Bathymetry fetch failed for ${depth}m at ${resolution}: ${response.status} ${response.statusText}`\r\n        );\r\n        return createEmptyCollection();\r\n      }\r\n\r\n      const data: GeoJSONCollection = await response.json();\r\n\r\n      // Validate response structure\r\n      if (data.type !== 'FeatureCollection' || !Array.isArray(data.features)) {\r\n        console.warn(`Invalid bathymetry GeoJSON structure for ${depth}m at ${resolution}`);\r\n        return createEmptyCollection();\r\n      }\r\n\r\n      // Cache the successful response\r\n      setInCache(cacheKey, data);\r\n\r\n      return data;\r\n    } catch (error) {\r\n      console.warn(`Bathymetry fetch error for ${depth}m at ${resolution}:`, error);\r\n      return createEmptyCollection();\r\n    } finally {\r\n      // Remove from pending requests\r\n      pendingRequests.delete(cacheKey);\r\n    }\r\n  })", "is_member_call": false, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L408"}, {"caller_nid": "services_geojsonservice_fetchbathymetrylayer", "callee": "set", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L443"}, {"caller_nid": "services_geojsonservice_getbathymetrylayers", "callee": "filter", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L462"}, {"caller_nid": "services_geojsonservice_getbathymetrylayers", "callee": "warn", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L467"}, {"caller_nid": "services_geojsonservice_getbathymetrylayers", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L472"}, {"caller_nid": "services_geojsonservice_getbathymetrylayers", "callee": "all", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L478"}, {"caller_nid": "services_geojsonservice_getbathymetrylayers", "callee": "warn", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\packages\\core\\src\\services\\geojsonService.ts", "source_location": "L485"}, {"caller_nid": "services_geojsonservice_preloadresolution", "callee": "map", "is_member_call": true, "source_file": "C:\\Users\\user01\\Desktop\\Ben\\Sea_Level_Dash_Open-Meteo\\seame (2)\\package