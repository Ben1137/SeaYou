{
  "functions": {
    "api/noaa/[...path].ts": {
      "runtime": "edge"
    }
  },
  "rewrites": [
    {
      "source": "/api/places/:path*",
      "destination": "https://maps.googleapis.com/maps/api/place/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
