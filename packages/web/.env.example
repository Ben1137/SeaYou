# ─────────────────────────────────────────────────────────────────────────────
# SeaYou — Web package environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local — they are in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# PWA base path — REQUIRED for correct PWA install + asset resolution.
#   /                  → Vercel and other root deployments (set in Vercel dashboard)
#   /SeaYou1.0/        → GitHub Pages at ben1137.github.io/SeaYou1.0/
#                         (set automatically by .github/workflows/deploy.yml)
# See README.md "Deployment" section for details.
VITE_PWA_BASE=/

# Supabase project credentials (from Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Places API key (for location search autocomplete)
VITE_GOOGLE_PLACES_API_KEY=

# AISStream.io WebSocket API key — DO NOT expose in production builds.
# Used only in the Supabase Edge Function (server-side); set as a Supabase
# Function Secret, not as a client env var.
# Local dev only: enables direct WS for testing the ais-relay function.
VITE_AISSTREAM_API_KEY=

# Enable the MapLibre/WebGL map (true) vs Leaflet fallback (false)
VITE_USE_WEBGL_MAP=true
